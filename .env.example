# Base URL of the Event OS API gateway (no trailing slash).
VITE_API_URL=http://localhost:8080

# Where the portal runs (one app for organizers, vendors and venues). "Sign in",
# "Create profile" and "List your venue" link here (/login and /register).
# The older name VITE_VENDOR_PORTAL_URL still works as a fallback.
VITE_PORTAL_URL=http://localhost:5173
